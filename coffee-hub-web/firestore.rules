rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Authentication helpers
    function isAuthenticated() {
      return request.auth != null;
    }

    function requestEmail() {
      return request.auth.token.email;
    }

    // Update this value before deploy if the production owner changes.
    function ownerEmail() {
      return 'coffeehubinkollu@gmail.com';
    }

    function isOwnEmail(email) {
      return isAuthenticated() &&
        requestEmail() is string &&
        requestEmail() == email;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (requestEmail() is string && requestEmail() == ownerEmail()) ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
        );
    }

    // Reusable field validators
    function isNonEmptyString(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    function isOptionalString(value, maxLength) {
      return value == null || (value is string && value.size() <= maxLength);
    }

    function isOptionalBoolean(value) {
      return value == null || value is bool;
    }

    function isNonNegativeNumber(value) {
      return value is number && value >= 0;
    }

    function isOptionalNonNegativeNumber(value) {
      return value == null || (value is number && value >= 0);
    }

    function isOptionalTimestamp(value) {
      return value == null || value is timestamp;
    }

    function isValidLocation(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly(['lat', 'lng', 'accuracy', 'updatedAt', 'updated_at']) &&
        value.lat is number &&
        value.lat >= -90 &&
        value.lat <= 90 &&
        value.lng is number &&
        value.lng >= -180 &&
        value.lng <= 180 &&
        isOptionalNonNegativeNumber(value.accuracy) &&
        isOptionalTimestamp(value.updatedAt) &&
        isOptionalTimestamp(value.updated_at)
      );
    }

    function isValidOrderStatus(value) {
      return value is string && value in [
        'pending',
        'accepted',
        'preparing',
        'out_for_delivery',
        'delivered',
        'rejected',
        'cancelled',
        'PENDING',
        'ACCEPTED',
        'PREPARING',
        'OUT_FOR_DELIVERY',
        'DELIVERED',
        'REJECTED',
        'CANCELLED'
      ];
    }

    function isValidPaymentStatus(value) {
      return value == null || (
        value is string &&
        value in ['PENDING', 'PAID', 'FAILED', 'REFUNDED', 'pending', 'paid', 'failed', 'refunded']
      );
    }

    function isValidOrderTimestamps(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly([
          'createdAt',
          'acceptedAt',
          'preparedAt',
          'outForDeliveryAt',
          'deliveredAt',
          'rejectedAt',
          'cancelledAt'
        ]) &&
        isOptionalTimestamp(value.createdAt) &&
        isOptionalTimestamp(value.acceptedAt) &&
        isOptionalTimestamp(value.preparedAt) &&
        isOptionalTimestamp(value.outForDeliveryAt) &&
        isOptionalTimestamp(value.deliveredAt) &&
        isOptionalTimestamp(value.rejectedAt) &&
        isOptionalTimestamp(value.cancelledAt)
      );
    }

    function isPendingOrderStatus(status, orderStatus, statusCode) {
      return status in ['pending', 'PENDING'] &&
        (orderStatus == null || orderStatus == 'PENDING') &&
        (statusCode == null || statusCode == 'PENDING');
    }

    function isAcceptedOrderStatus(status, orderStatus, statusCode) {
      return status in ['accepted', 'ACCEPTED'] &&
        (orderStatus == null || orderStatus == 'ACCEPTED') &&
        (statusCode == null || statusCode == 'ACCEPTED');
    }

    function isPreparingOrderStatus(status, orderStatus, statusCode) {
      return status in ['preparing', 'PREPARING'] &&
        (orderStatus == null || orderStatus == 'PREPARING') &&
        (statusCode == null || statusCode == 'PREPARING');
    }

    function isOutForDeliveryOrderStatus(status, orderStatus, statusCode) {
      return status in ['out_for_delivery', 'OUT_FOR_DELIVERY'] &&
        (orderStatus == null || orderStatus == 'OUT_FOR_DELIVERY') &&
        (statusCode == null || statusCode == 'OUT_FOR_DELIVERY');
    }

    function isDeliveredOrderStatus(status, orderStatus, statusCode) {
      return status in ['delivered', 'DELIVERED'] &&
        (orderStatus == null || orderStatus == 'DELIVERED') &&
        (statusCode == null || statusCode == 'DELIVERED');
    }

    function isRejectedOrderStatus(status, orderStatus, statusCode) {
      return status in ['rejected', 'REJECTED'] &&
        (orderStatus == null || orderStatus == 'REJECTED') &&
        (statusCode == null || statusCode == 'REJECTED');
    }

    function isCancelledOrderStatus(status, orderStatus, statusCode) {
      return status in ['cancelled', 'CANCELLED'] &&
        (orderStatus == null || orderStatus == 'CANCELLED') &&
        (statusCode == null || statusCode == 'CANCELLED');
    }

    function hasMatchingOrderStatuses(status, orderStatus, statusCode) {
      return (
        isPendingOrderStatus(status, orderStatus, statusCode) ||
        isAcceptedOrderStatus(status, orderStatus, statusCode) ||
        isPreparingOrderStatus(status, orderStatus, statusCode) ||
        isOutForDeliveryOrderStatus(status, orderStatus, statusCode) ||
        isDeliveredOrderStatus(status, orderStatus, statusCode) ||
        isRejectedOrderStatus(status, orderStatus, statusCode) ||
        isCancelledOrderStatus(status, orderStatus, statusCode)
      );
    }

    function isAgentDocumentOwner(agentId) {
      return isAuthenticated() && (
        request.auth.uid == agentId ||
        (requestEmail() is string && requestEmail() == agentId)
      );
    }

    function isAssignedAgentForOrder(data) {
      return isAuthenticated() && (
        request.auth.uid in [
          data.assignedAgentId,
          data.deliveryAgentId,
          data.agentId,
          data.delivery_agent_id
        ] ||
        (requestEmail() is string && requestEmail() in [
          data.assignedAgentEmail,
          data.deliveryAgentEmail,
          data.agentEmail,
          data.assignedAgentId,
          data.deliveryAgentId,
          data.agentId,
          data.delivery_agent_id
        ])
      );
    }

    function hasAssignedAgentIdentity(data) {
      return (
        isNonEmptyString(data.assignedAgentId, 120) ||
        isNonEmptyString(data.deliveryAgentId, 120) ||
        isNonEmptyString(data.agentId, 120) ||
        isNonEmptyString(data.delivery_agent_id, 120)
      );
    }

    function isValidAgentStatus(value) {
      return value == null || (
        value is string &&
        value in ['active', 'available', 'busy', 'offline']
      );
    }

    function isValidDeliverySessionStatus(value) {
      return value == null || (
        value is string &&
        value in ['assigned', 'active', 'completed']
      );
    }

    function hasAllowedMenuItemKeys(data) {
      return data.keys().hasOnly([
        'name',
        'category',
        'price',
        'description',
        'image',
        'image_url',
        'rating',
        'spiceLevel',
        'spice_level',
        'veg',
        'is_veg',
        'isAvailable',
        'is_available',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidMenuItem(data) {
      return hasAllowedMenuItemKeys(data) &&
        isNonEmptyString(data.name, 120) &&
        isNonEmptyString(data.category, 80) &&
        isNonNegativeNumber(data.price) &&
        isOptionalString(data.description, 2000) &&
        isOptionalString(data.image, 2048) &&
        isOptionalString(data.image_url, 2048) &&
        (data.rating == null || (data.rating is number && data.rating >= 0 && data.rating <= 5)) &&
        isOptionalString(data.spiceLevel, 40) &&
        isOptionalString(data.spice_level, 40) &&
        isOptionalBoolean(data.veg) &&
        isOptionalBoolean(data.is_veg) &&
        isOptionalBoolean(data.isAvailable) &&
        isOptionalBoolean(data.is_available) &&
        isOptionalTimestamp(data.createdAt) &&
        isOptionalTimestamp(data.updatedAt);
    }

    function hasAllowedOrderKeys(data) {
      return data.keys().hasOnly([
        'orderId',
        'userId',
        'name',
        'phone',
        'address',
        'customerLocation',
        'customer_location',
        'deliveryLocation',
        'delivery_location',
        'items',
        'subtotal',
        'discount',
        'deliveryFee',
        'delivery_fee',
        'couponCode',
        'coupon_code',
        'totalAmount',
        'total_amount',
        'finalAmount',
        'final_total',
        'paymentMode',
        'payment_method',
        'paymentStatus',
        'payment_status',
        'status',
        'orderStatus',
        'status_code',
        'rejectionReason',
        'rejection_reason',
        'cancellationReason',
        'cancellation_reason',
        'createdAt',
        'created_at',
        'updatedAt',
        'updated_at',
        'timestamps',
        'acceptedAt',
        'accepted_at',
        'preparingAt',
        'preparing_at',
        'assignedAt',
        'assigned_at',
        'deliveryAssignedAt',
        'delivery_assigned_at',
        'pickedAt',
        'deliveryPickedAt',
        'delivery_picked_at',
        'readyAt',
        'readyForPickupAt',
        'ready_for_pickup_at',
        'outForDeliveryAt',
        'out_for_delivery_at',
        'deliveryOutForDeliveryAt',
        'delivery_out_for_delivery_at',
        'deliveredAt',
        'delivered_at',
        'deliveryDeliveredAt',
        'delivery_delivered_at',
        'rejectedAt',
        'rejected_at',
        'cancelledAt',
        'cancelled_at',
        'assignedAgentId',
        'assignedAgentName',
        'assignedAgentPhone',
        'assignedAgentEmail',
        'assignedAgentVehicle',
        'deliveryAgentId',
        'deliveryAgentName',
        'deliveryAgentPhone',
        'deliveryAgentEmail',
        'deliveryAgentVehicle',
        'agentId',
        'agentName',
        'agentPhone',
        'agentEmail',
        'agentVehicle',
        'delivery_agent_id',
        'delivery_agent_name',
        'delivery_agent_phone',
        'delivery_agent_email',
        'delivery_agent_vehicle'
      ]);
    }

    function isValidOrderCreate(data) {
      return hasAllowedOrderKeys(data) &&
        isNonEmptyString(data.orderId, 40) &&
        data.userId is string &&
        isOwner(data.userId) &&
        isNonEmptyString(data.name, 120) &&
        isNonEmptyString(data.phone, 30) &&
        isNonEmptyString(data.address, 500) &&
        data.items is list &&
        data.items.size() > 0 &&
        isNonNegativeNumber(data.subtotal) &&
        isOptionalNonNegativeNumber(data.discount) &&
        isOptionalNonNegativeNumber(data.deliveryFee) &&
        isOptionalString(data.couponCode, 50) &&
        isNonNegativeNumber(data.totalAmount) &&
        isOptionalNonNegativeNumber(data.finalAmount) &&
        (data.finalAmount == null || data.finalAmount == data.totalAmount) &&
        isOptionalString(data.paymentMode, 20) &&
        isValidPaymentStatus(data.paymentStatus) &&
        isValidOrderStatus(data.status) &&
        isValidOrderStatus(data.orderStatus) &&
        isOptionalString(data.status_code, 40) &&
        hasMatchingOrderStatuses(data.status, data.orderStatus, data.status_code) &&
        data.status in ['pending', 'PENDING'] &&
        data.orderStatus == 'PENDING' &&
        (data.status_code == null || data.status_code == 'PENDING') &&
        (data.paymentStatus == null || data.paymentStatus in ['PENDING', 'pending']) &&
        (data.rejectionReason == null || data.rejectionReason == '') &&
        (data.cancellationReason == null || data.cancellationReason == '') &&
        isValidLocation(data.customerLocation) &&
        isValidLocation(data.customer_location) &&
        isValidLocation(data.deliveryLocation) &&
        isValidLocation(data.delivery_location) &&
        isValidOrderTimestamps(data.timestamps) &&
        isOptionalTimestamp(data.createdAt) &&
        isOptionalTimestamp(data.created_at) &&
        isOptionalTimestamp(data.updatedAt) &&
        isOptionalTimestamp(data.updated_at) &&
        (data.assignedAgentId == null || data.assignedAgentId == '') &&
        (data.assignedAgentName == null || data.assignedAgentName == '') &&
        (data.assignedAgentPhone == null || data.assignedAgentPhone == '') &&
        (data.assignedAgentEmail == null || data.assignedAgentEmail == '') &&
        (data.assignedAgentVehicle == null || data.assignedAgentVehicle == '') &&
        (data.deliveryAgentId == null || data.deliveryAgentId == '') &&
        (data.deliveryAgentName == null || data.deliveryAgentName == '') &&
        (data.deliveryAgentPhone == null || data.deliveryAgentPhone == '') &&
        (data.deliveryAgentEmail == null || data.deliveryAgentEmail == '') &&
        (data.deliveryAgentVehicle == null || data.deliveryAgentVehicle == '') &&
        (data.agentId == null || data.agentId == '') &&
        (data.agentName == null || data.agentName == '') &&
        (data.agentPhone == null || data.agentPhone == '') &&
        (data.agentEmail == null || data.agentEmail == '') &&
        (data.agentVehicle == null || data.agentVehicle == '') &&
        (data.delivery_agent_id == null || data.delivery_agent_id == '') &&
        (data.delivery_agent_name == null || data.delivery_agent_name == '') &&
        (data.delivery_agent_phone == null || data.delivery_agent_phone == '') &&
        (data.delivery_agent_email == null || data.delivery_agent_email == '') &&
        (data.delivery_agent_vehicle == null || data.delivery_agent_vehicle == '');
    }

    function hasOnlyAdminManagedOrderChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'orderStatus',
        'status_code',
        'paymentStatus',
        'payment_status',
        'rejectionReason',
        'rejection_reason',
        'cancellationReason',
        'cancellation_reason',
        'updatedAt',
        'updated_at',
        'timestamps',
        'acceptedAt',
        'accepted_at',
        'preparingAt',
        'preparing_at',
        'assignedAt',
        'assigned_at',
        'deliveryAssignedAt',
        'delivery_assigned_at',
        'pickedAt',
        'deliveryPickedAt',
        'delivery_picked_at',
        'readyAt',
        'readyForPickupAt',
        'ready_for_pickup_at',
        'outForDeliveryAt',
        'out_for_delivery_at',
        'deliveryOutForDeliveryAt',
        'delivery_out_for_delivery_at',
        'deliveredAt',
        'delivered_at',
        'deliveryDeliveredAt',
        'delivery_delivered_at',
        'rejectedAt',
        'rejected_at',
        'cancelledAt',
        'cancelled_at',
        'deliveryLocation',
        'delivery_location',
        'assignedAgentId',
        'assignedAgentName',
        'assignedAgentPhone',
        'assignedAgentEmail',
        'assignedAgentVehicle',
        'deliveryAgentId',
        'deliveryAgentName',
        'deliveryAgentPhone',
        'deliveryAgentEmail',
        'deliveryAgentVehicle',
        'agentId',
        'agentName',
        'agentPhone',
        'agentEmail',
        'agentVehicle'
      ]);
    }

    function isValidAdminOrderUpdate() {
      return hasAllowedOrderKeys(request.resource.data) &&
        hasOnlyAdminManagedOrderChanges() &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.address == resource.data.address &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.deliveryFee == resource.data.deliveryFee &&
        request.resource.data.couponCode == resource.data.couponCode &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.finalAmount == resource.data.finalAmount &&
        request.resource.data.paymentMode == resource.data.paymentMode &&
        request.resource.data.customerLocation == resource.data.customerLocation &&
        request.resource.data.customer_location == resource.data.customer_location &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidOrderStatus(request.resource.data.status) &&
        isValidOrderStatus(request.resource.data.orderStatus) &&
        hasMatchingOrderStatuses(
          request.resource.data.status,
          request.resource.data.orderStatus,
          request.resource.data.status_code,
        ) &&
        isValidPaymentStatus(request.resource.data.paymentStatus) &&
        isValidPaymentStatus(request.resource.data.payment_status) &&
        isOptionalString(request.resource.data.rejectionReason, 500) &&
        isOptionalString(request.resource.data.rejection_reason, 500) &&
        isOptionalString(request.resource.data.cancellationReason, 500) &&
        isOptionalString(request.resource.data.cancellation_reason, 500) &&
        isOptionalString(request.resource.data.status_code, 40) &&
        isOptionalString(request.resource.data.assignedAgentId, 120) &&
        isOptionalString(request.resource.data.assignedAgentName, 120) &&
        isOptionalString(request.resource.data.assignedAgentPhone, 30) &&
        isOptionalString(request.resource.data.assignedAgentEmail, 320) &&
        isOptionalString(request.resource.data.assignedAgentVehicle, 120) &&
        isOptionalString(request.resource.data.deliveryAgentId, 120) &&
        isOptionalString(request.resource.data.deliveryAgentName, 120) &&
        isOptionalString(request.resource.data.deliveryAgentPhone, 30) &&
        isOptionalString(request.resource.data.deliveryAgentEmail, 320) &&
        isOptionalString(request.resource.data.deliveryAgentVehicle, 120) &&
        isOptionalString(request.resource.data.agentId, 120) &&
        isOptionalString(request.resource.data.agentName, 120) &&
        isOptionalString(request.resource.data.agentPhone, 30) &&
        isOptionalString(request.resource.data.agentEmail, 320) &&
        isOptionalString(request.resource.data.agentVehicle, 120) &&
        isValidLocation(request.resource.data.deliveryLocation) &&
        isValidLocation(request.resource.data.delivery_location) &&
        isValidOrderTimestamps(request.resource.data.timestamps) &&
        isOptionalTimestamp(request.resource.data.updatedAt) &&
        isOptionalTimestamp(request.resource.data.updated_at) &&
        isOptionalTimestamp(request.resource.data.acceptedAt) &&
        isOptionalTimestamp(request.resource.data.accepted_at) &&
        isOptionalTimestamp(request.resource.data.preparingAt) &&
        isOptionalTimestamp(request.resource.data.preparing_at) &&
        isOptionalTimestamp(request.resource.data.assignedAt) &&
        isOptionalTimestamp(request.resource.data.assigned_at) &&
        isOptionalTimestamp(request.resource.data.deliveryAssignedAt) &&
        isOptionalTimestamp(request.resource.data.delivery_assigned_at) &&
        isOptionalTimestamp(request.resource.data.pickedAt) &&
        isOptionalTimestamp(request.resource.data.deliveryPickedAt) &&
        isOptionalTimestamp(request.resource.data.delivery_picked_at) &&
        isOptionalTimestamp(request.resource.data.readyAt) &&
        isOptionalTimestamp(request.resource.data.readyForPickupAt) &&
        isOptionalTimestamp(request.resource.data.ready_for_pickup_at) &&
        isOptionalTimestamp(request.resource.data.outForDeliveryAt) &&
        isOptionalTimestamp(request.resource.data.out_for_delivery_at) &&
        isOptionalTimestamp(request.resource.data.deliveryOutForDeliveryAt) &&
        isOptionalTimestamp(request.resource.data.delivery_out_for_delivery_at) &&
        isOptionalTimestamp(request.resource.data.deliveredAt) &&
        isOptionalTimestamp(request.resource.data.delivered_at) &&
        isOptionalTimestamp(request.resource.data.deliveryDeliveredAt) &&
        isOptionalTimestamp(request.resource.data.delivery_delivered_at) &&
        isOptionalTimestamp(request.resource.data.rejectedAt) &&
        isOptionalTimestamp(request.resource.data.rejected_at) &&
        isOptionalTimestamp(request.resource.data.cancelledAt) &&
        isOptionalTimestamp(request.resource.data.cancelled_at);
    }

    function hasOnlyAgentManagedOrderChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'status',
        'orderStatus',
        'status_code',
        'updatedAt',
        'updated_at',
        'pickedAt',
        'deliveryPickedAt',
        'delivery_picked_at',
        'deliveredAt',
        'delivered_at',
        'deliveryDeliveredAt',
        'delivery_delivered_at',
        'deliveryLocation',
        'delivery_location',
        'timestamps'
      ]);
    }

    function isValidAgentOrderUpdate() {
      return hasAllowedOrderKeys(request.resource.data) &&
        hasOnlyAgentManagedOrderChanges() &&
        isAssignedAgentForOrder(resource.data) &&
        request.resource.data.orderId == resource.data.orderId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.address == resource.data.address &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.deliveryFee == resource.data.deliveryFee &&
        request.resource.data.couponCode == resource.data.couponCode &&
        request.resource.data.totalAmount == resource.data.totalAmount &&
        request.resource.data.finalAmount == resource.data.finalAmount &&
        request.resource.data.paymentMode == resource.data.paymentMode &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.payment_status == resource.data.payment_status &&
        request.resource.data.rejectionReason == resource.data.rejectionReason &&
        request.resource.data.rejection_reason == resource.data.rejection_reason &&
        request.resource.data.cancellationReason == resource.data.cancellationReason &&
        request.resource.data.cancellation_reason == resource.data.cancellation_reason &&
        request.resource.data.assignedAgentId == resource.data.assignedAgentId &&
        request.resource.data.assignedAgentName == resource.data.assignedAgentName &&
        request.resource.data.assignedAgentPhone == resource.data.assignedAgentPhone &&
        request.resource.data.assignedAgentEmail == resource.data.assignedAgentEmail &&
        request.resource.data.assignedAgentVehicle == resource.data.assignedAgentVehicle &&
        request.resource.data.deliveryAgentId == resource.data.deliveryAgentId &&
        request.resource.data.deliveryAgentName == resource.data.deliveryAgentName &&
        request.resource.data.deliveryAgentPhone == resource.data.deliveryAgentPhone &&
        request.resource.data.deliveryAgentEmail == resource.data.deliveryAgentEmail &&
        request.resource.data.deliveryAgentVehicle == resource.data.deliveryAgentVehicle &&
        request.resource.data.agentId == resource.data.agentId &&
        request.resource.data.agentName == resource.data.agentName &&
        request.resource.data.agentPhone == resource.data.agentPhone &&
        request.resource.data.agentEmail == resource.data.agentEmail &&
        request.resource.data.agentVehicle == resource.data.agentVehicle &&
        request.resource.data.customerLocation == resource.data.customerLocation &&
        request.resource.data.customer_location == resource.data.customer_location &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.created_at == resource.data.created_at &&
        isValidLocation(request.resource.data.deliveryLocation) &&
        isValidLocation(request.resource.data.delivery_location) &&
        isValidOrderTimestamps(request.resource.data.timestamps) &&
        (
          (
            isOutForDeliveryOrderStatus(
              request.resource.data.status,
              request.resource.data.orderStatus,
              request.resource.data.status_code,
            ) &&
            isOutForDeliveryOrderStatus(
              resource.data.status,
              resource.data.orderStatus,
              resource.data.status_code,
            )
          ) ||
          (
            isDeliveredOrderStatus(
              request.resource.data.status,
              request.resource.data.orderStatus,
              request.resource.data.status_code,
            ) &&
            isOutForDeliveryOrderStatus(
              resource.data.status,
              resource.data.orderStatus,
              resource.data.status_code,
            ) &&
            hasAssignedAgentIdentity(resource.data)
          )
        );
    }

    function hasAllowedUserKeys(data) {
      return data.keys().hasOnly([
        'name',
        'clerkId',
        'phone',
        'email',
        'notificationPermission',
        'notificationSettings',
        'addresses',
        'addressEntries',
        'role',
        'adminLocation',
        'vehicleType',
        'status',
        'fcmToken',
        'fcmTokenUpdatedAt',
        'pushToken',
        'pushTokenUpdatedAt',
        'createdAt',
        'updatedAt'
      ]);
    }

    function isValidUserRole(value) {
      return value == null || value in ['customer', 'admin', 'agent'];
    }

    function isMatchingUserEmail(value) {
      return value == null || (
        value is string &&
        (
          (requestEmail() is string && value == requestEmail()) ||
          (!(requestEmail() is string) && value.size() == 0)
        )
      );
    }

    function isValidNotificationSettings(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly(['orderUpdates', 'offers', 'promotions']) &&
        isOptionalBoolean(value.orderUpdates) &&
        isOptionalBoolean(value.offers) &&
        isOptionalBoolean(value.promotions)
      );
    }

    function isValidAddresses(value) {
      return value == null || (
        value is map &&
        value.keys().hasOnly(['address1', 'address2', 'address3']) &&
        isOptionalString(value.address1, 240) &&
        isOptionalString(value.address2, 240) &&
        isOptionalString(value.address3, 240)
      );
    }

    function isValidAddressEntries(value) {
      return value == null || (value is list && value.size() <= 10);
    }

    function isValidUserRecord(data) {
      return hasAllowedUserKeys(data) &&
        isOptionalString(data.clerkId, 120) &&
        isOptionalString(data.name, 120) &&
        isOptionalString(data.phone, 30) &&
        isMatchingUserEmail(data.email) &&
        isOptionalString(data.notificationPermission, 20) &&
        isValidNotificationSettings(data.notificationSettings) &&
        isValidAddresses(data.addresses) &&
        isValidAddressEntries(data.addressEntries) &&
        isValidUserRole(data.role) &&
        isOptionalString(data.adminLocation, 120) &&
        isOptionalString(data.vehicleType, 80) &&
        isOptionalString(data.status, 40) &&
        isOptionalString(data.fcmToken, 4096) &&
        isOptionalTimestamp(data.fcmTokenUpdatedAt) &&
        isOptionalString(data.pushToken, 4096) &&
        isOptionalTimestamp(data.pushTokenUpdatedAt) &&
        isOptionalTimestamp(data.createdAt) &&
        isOptionalTimestamp(data.updatedAt);
    }

    function isValidOwnUserCreate(userId) {
      return isValidUserRecord(request.resource.data) &&
        request.resource.data.clerkId == userId &&
        request.resource.data.role == 'customer';
    }

    function isValidOwnUserUpdate() {
      return isValidUserRecord(request.resource.data) &&
        request.resource.data.clerkId == resource.data.clerkId &&
        request.resource.data.role == resource.data.role;
    }

    function isValidAgentAccessRecord(data, email) {
      return data.keys().hasOnly([
        'email',
        'role',
        'accessOnly',
        'isActive',
        'status',
        'currentOrderId',
        'name',
        'phone',
        'vehicle',
        'currentLocation',
        'lastLocation',
        'createdAt',
        'updatedAt'
      ]) &&
        (data.email == null || (data.email is string && data.email.size() <= 320)) &&
        isOptionalString(data.role, 40) &&
        isOptionalBoolean(data.accessOnly) &&
        isOptionalBoolean(data.isActive) &&
        isValidAgentStatus(data.status) &&
        isOptionalString(data.currentOrderId, 120) &&
        isOptionalString(data.name, 120) &&
        isOptionalString(data.phone, 30) &&
        isOptionalString(data.vehicle, 120) &&
        isValidLocation(data.currentLocation) &&
        isValidLocation(data.lastLocation) &&
        isOptionalTimestamp(data.createdAt) &&
        isOptionalTimestamp(data.updatedAt);
    }

    function hasOnlyAgentSelfManagedAgentChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'isActive',
        'status',
        'currentOrderId',
        'currentLocation',
        'lastLocation',
        'updatedAt'
      ]);
    }

    function isValidAgentSelfUpdate(agentId) {
      return isAgentDocumentOwner(agentId) &&
        isValidAgentAccessRecord(request.resource.data, agentId) &&
        hasOnlyAgentSelfManagedAgentChanges() &&
        request.resource.data.email == resource.data.email &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.accessOnly == resource.data.accessOnly &&
        request.resource.data.name == resource.data.name &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.vehicle == resource.data.vehicle &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    function isValidAgentSelfCreate(agentId) {
      return isAgentDocumentOwner(agentId) &&
        isValidAgentAccessRecord(request.resource.data, agentId) &&
        (request.resource.data.email == null || request.resource.data.email == agentId) &&
        (request.resource.data.role == null || request.resource.data.role == 'agent') &&
        request.resource.data.accessOnly != true;
    }

    function hasAllowedDeliverySessionKeys(data) {
      return data.keys().hasOnly([
        'agentEmail',
        'agentId',
        'agentName',
        'agentPhone',
        'agentVehicle',
        'completedAt',
        'customerLocation',
        'lastLocation',
        'orderDocId',
        'orderId',
        'startedAt',
        'status',
        'updatedAt'
      ]);
    }

    function isValidDeliverySessionDocument(data, orderId) {
      return hasAllowedDeliverySessionKeys(data) &&
        data.orderId == orderId &&
        isOptionalString(data.orderDocId, 120) &&
        isOptionalString(data.agentId, 120) &&
        isOptionalString(data.agentEmail, 320) &&
        isOptionalString(data.agentName, 120) &&
        isOptionalString(data.agentPhone, 30) &&
        isOptionalString(data.agentVehicle, 120) &&
        isValidDeliverySessionStatus(data.status) &&
        isValidLocation(data.customerLocation) &&
        isValidLocation(data.lastLocation) &&
        isOptionalTimestamp(data.startedAt) &&
        isOptionalTimestamp(data.completedAt) &&
        isOptionalTimestamp(data.updatedAt);
    }

    function isDeliverySessionAgent(data) {
      return data != null && (
        isAgentDocumentOwner(data.agentId) ||
        (requestEmail() is string && requestEmail() == data.agentEmail)
      );
    }

    function hasAllowedAgentLocationKeys(data) {
      return data.keys().hasOnly([
        'lat',
        'lng',
        'accuracy',
        'agentId',
        'orderDocId',
        'updatedAt'
      ]);
    }

    function isValidAgentLocationDocument(data) {
      return hasAllowedAgentLocationKeys(data) &&
        data.lat is number &&
        data.lat >= -90 &&
        data.lat <= 90 &&
        data.lng is number &&
        data.lng >= -180 &&
        data.lng <= 180 &&
        isOptionalNonNegativeNumber(data.accuracy) &&
        isOptionalString(data.agentId, 120) &&
        isOptionalString(data.orderDocId, 120) &&
        isOptionalTimestamp(data.updatedAt);
    }

    // menu_items: public catalog, admin-managed writes
    match /menu_items/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /menu/{itemId} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidMenuItem(request.resource.data);
      allow delete: if isAdmin();
    }

    match /offers/{offerId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // orders: customers create and read their own, admins can review and update status
    match /orders/{orderId} {
      allow read: if
        isAdmin() ||
        isOwner(resource.data.userId);
      allow create: if false;
      allow update: if isAdmin() && isValidAdminOrderUpdate();
      allow delete: if false;
    }

    // users: each signed-in user can only manage their own profile document
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if
        (isOwner(userId) && isValidOwnUserCreate(userId)) ||
        (isAdmin() && isValidUserRecord(request.resource.data));
      allow update: if
        (isOwner(userId) && isValidOwnUserUpdate()) ||
        (isAdmin() && isValidUserRecord(request.resource.data));
      allow delete: if isAdmin();
    }

    // agents: delivery operations data, writable only by admins or the agent owner
    match /agents/{email} {
      allow read: if true;
      allow create: if
        (isAdmin() && isValidAgentAccessRecord(request.resource.data, email)) ||
        isValidAgentSelfCreate(email);
      allow update: if
        (isAdmin() && isValidAgentAccessRecord(request.resource.data, email)) ||
        isValidAgentSelfUpdate(email);
      allow delete: if isAdmin();
    }

    match /delivery_sessions/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if
        (
          isAdmin() ||
          isDeliverySessionAgent(request.resource.data) ||
          isDeliverySessionAgent(resource.data)
        ) &&
        isValidDeliverySessionDocument(request.resource.data, orderId);
      allow delete: if isAdmin();
    }

    match /agent_locations/{orderId} {
      allow read: if isAuthenticated();
      allow create, update: if
        (isAdmin() || isAgentDocumentOwner(request.resource.data.agentId)) &&
        isValidAgentLocationDocument(request.resource.data);
      allow delete: if isAdmin();
    }

    match /meta/{docId} {
      allow read: if false;
      allow create, update: if
        isAdmin() &&
        docId == 'orderCounter' &&
        request.resource.data.keys().hasOnly(['nextOrderNumber']) &&
        request.resource.data.nextOrderNumber is number &&
        request.resource.data.nextOrderNumber >= 1001;
      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
