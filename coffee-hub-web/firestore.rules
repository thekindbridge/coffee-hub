rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admin_access/$(userEmail()));
    }

    function isDeliveryAgent() {
      return signedIn() &&
        exists(/databases/$(database)/documents/agents/$(userEmail()));
    }

    function isAssignedAgentEmail(orderData) {
      return signedIn() &&
        (orderData.assignedAgentId == userEmail() ||
          orderData.assignedAgentEmail == userEmail() ||
          orderData.agentEmail == userEmail() ||
          orderData.deliveryAgentEmail == userEmail());
    }

    function isOrderOwner() {
      return signedIn() && resource.data.userId == request.auth.uid;
    }

    function isAssignedAgent() {
      return isAssignedAgentEmail(resource.data);
    }

    function isOrderOwnerById(orderId) {
      return signedIn() &&
        get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid;
    }

    function isAssignedAgentByOrder(orderId) {
      return signedIn() &&
        (get(/databases/$(database)/documents/orders/$(orderId)).data.assignedAgentId == userEmail() ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.assignedAgentEmail == userEmail() ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.agentEmail == userEmail() ||
          get(/databases/$(database)/documents/orders/$(orderId)).data.deliveryAgentEmail == userEmail());
    }

    function isValidCoordinate(value, minimum, maximum) {
      return value is number && value >= minimum && value <= maximum;
    }

    function isValidDeliveryLocation(location) {
      return location == null || (
        location is map &&
        location.keys().hasOnly(['lat', 'lng', 'accuracy', 'updatedAt']) &&
        isValidCoordinate(location.lat, -90, 90) &&
        isValidCoordinate(location.lng, -180, 180) &&
        (location.accuracy == null || location.accuracy is number) &&
        (location.updatedAt == null || location.updatedAt is timestamp)
      );
    }

    function hasOnlyAssignedAgentTrackingChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'deliveryLocation',
        'updatedAt',
        'status',
        'orderStatus',
        'deliveredAt',
        'deliveryDeliveredAt'
      ]);
    }

    function isAssignedAgentTrackingOwnOrder() {
      return isAssignedAgentEmail(resource.data) &&
        resource.data.status == 'OUT_FOR_DELIVERY' &&
        request.resource.data.updatedAt is timestamp &&
        isValidDeliveryLocation(request.resource.data.deliveryLocation) &&
        hasOnlyAssignedAgentTrackingChanges() &&
        (
          (
            request.resource.data.status == resource.data.status &&
            request.resource.data.orderStatus == resource.data.orderStatus
          ) ||
          (
            request.resource.data.status == 'DELIVERED' &&
            request.resource.data.orderStatus == 'DELIVERED' &&
            request.resource.data.deliveredAt is timestamp &&
            request.resource.data.deliveryDeliveredAt is timestamp
          )
        );
    }

    function isOwnAgentDocument(agentId) {
      return signedIn() &&
        (agentId == userEmail() ||
          resource.data.email == userEmail() ||
          request.resource.data.email == userEmail());
    }

    match /orders/{orderId} {
      allow read: if isAdmin() || isOrderOwner() || isAssignedAgent();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || isAssignedAgentTrackingOwnOrder();
      allow delete: if isAdmin();
    }

    match /order_items/{itemId} {
      allow read: if isAdmin() ||
        (resource.data.orderDocId != null &&
          (isOrderOwnerById(resource.data.orderDocId) ||
            isAssignedAgentByOrder(resource.data.orderDocId))) ||
        (resource.data.orderDocId == null && signedIn());
      allow create: if signedIn();
      allow update, delete: if isAdmin();
    }

    match /agents/{agentId} {
      allow read: if isAdmin() || signedIn();
      allow create, update: if isAdmin() || isOwnAgentDocument(agentId);
      allow delete: if isAdmin();
    }

    match /delivery_sessions/{sessionId} {
      allow read: if isAdmin() ||
        isDeliveryAgent() ||
        (resource.data.orderDocId != null &&
          (isOrderOwnerById(resource.data.orderDocId) ||
            isAssignedAgentByOrder(resource.data.orderDocId)));
      allow write: if isAdmin() || isDeliveryAgent();
    }

    match /agent_locations/{sessionId} {
      allow read: if isAdmin() ||
        isDeliveryAgent() ||
        (resource.data.orderDocId != null &&
          (isOrderOwnerById(resource.data.orderDocId) ||
            isAssignedAgentByOrder(resource.data.orderDocId)));
      allow write: if isAdmin() || isDeliveryAgent();
    }

    match /settings/{settingId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    match /admin_access/{email} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.email == email);
      allow create, update: if signedIn() && request.auth.token.email == email;
      allow delete: if isAdmin();
    }
  }
}
